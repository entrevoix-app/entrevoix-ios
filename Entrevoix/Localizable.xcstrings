    "The API key could not be stored securely." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API n’a pas pu être stockée de manière sécurisée."
          }
        }
      }
    },
    "The key is stored in the device Keychain; it is never written to Entrevoix preferences." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé est stockée dans le trousseau de l’appareil ; elle n’est jamais écrite dans les préférences d’Entrevoix."
          }
        }
      }
    },
    "These settings were created by a newer version of Entrevoix." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages ont été créés par une version plus récente d’Entrevoix."
          }
        }
      }
    },
    "This also removes the prompt from saved workflows." : {
      "comment" : "A confirmation dialog message that appears when a user deletes a prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime aussi l’invite des flux de travail enregistrés."
          }
        }
      }
    },
    "This removes Entrevoix preferences from this device. API keys remain protected in your Keychain." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime les préférences d’Entrevoix de cet appareil. Les clés API restent protégées dans votre trousseau."
          }
        }
      }
    },
    "Trim leading and trailing silence" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le silence au début et à la fin"
          }
        }
      }
    },
